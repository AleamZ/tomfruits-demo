# Copy thành server/.env rồi điền. KHÔNG commit file .env.
# Lấy ở KiotViet: Thiết lập > Thiết lập kết nối API (Client ID, Mã bảo mật)
KIOTVIET_RETAILER=ten-shop-tren-kiotviet
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=

# Tự đặt (>= 8 ký tự), dùng để kiểm tra chữ ký webhook. Để trống = không kiểm tra.
KIOTVIET_WEBHOOK_SECRET=

PORT=8888
# Đồng bộ thay đổi định kỳ (phút). 0 = tắt.
SYNC_INTERVAL_MINUTES=10
# Domain giao diện khi chạy thật (cách nhau dấu phẩy). localhost mọi cổng luôn được phép.
CORS_ORIGIN=
